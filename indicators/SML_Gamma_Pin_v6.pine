// © ScriptMaster Labs — GAMMA PIN v6
// =============================================================================
// Chart visual companion to gamma_pin_scanner.py / GET /api/gamma-pin/<symbol>
// (SqueezeOS repo, built 2026-07-25). Read this whole header before trading
// off this script — it is NOT the same signal as the live server-side one.
//
// WHY THIS SCRIPT CANNOT REPLICATE THE REAL SIGNAL:
// Pine Script has no built-in access to an options chain's real open
// interest by strike for an arbitrary underlying — there is no
// request.security() feed for "OI at strike K, expiry E" the way there is
// for price/volume. The real engine (gamma_flow_engine.calculate_gex_profile
// + detect_pin_risk, consumed via gamma_pin_scanner.py) pulls a live Tradier
// options chain server-side and finds the REAL max-open-interest strike.
// This script cannot do that, and does not pretend to — see AGENT_LAW /
// DEVELOPER_MANIFESTO "NO DEMO DATA" / "ZERO FAKE COMPLIANCE".
//
// WHAT THIS SCRIPT ACTUALLY SHOWS INSTEAD:
//   1. A REAL, exactly-computed calendar countdown to the nearest standard
//      equity-options expiry (weekly Friday and/or monthly 3rd-Friday, your
//      choice below) — same 0-2 DTE pin-risk window gamma_pin_scanner.py
//      uses (GAMMA_PIN default). This part is exact, not a proxy.
//   2. A round-number strike GRID as a visual reference — NOT real open
//      interest. High-OI strikes in liquid names often cluster near round
//      numbers, but this is a heuristic, not measured data. The $200/$25/$5
//      tiers reuse the exact real thresholds gamma_flow_engine.py's
//      _update_gamma_pressure() already uses server-side; two coarser tiers
//      were added above $2,000/$10,000 so the grid stays proportionally
//      meaningful at crypto-pair price scales (see f_gridIncrement()'s
//      comment for why — a flat $10 increment made "pin zone" fire on
//      nearly every BTCUSD bar before this fix).
//   3. An OPTIONAL manual strike override: type in the real max-OI strike
//      from GET /api/gamma-pin/<symbol> (or your own broker's chain) and
//      this script will use THAT real number for the proximity check and
//      direction lean instead of the round-number grid guess.
//
// SCOPE: this is a companion to a Tradier-backed US equity/ETF options
// scanner. Tradier has no crypto options chain, so on a symbol like
// BTCUSD the calendar/grid math above still runs (it's just arithmetic),
// but GET /api/gamma-pin/BTCUSD -- the "real signal" this script keeps
// pointing to -- would 503. Useful as a reference visual on any symbol,
// but only actually backed by a real chain for what Tradier covers.
//
// NO WEBHOOK BRIDGE. Unlike the IMO/ORB/DRUCK/CIE/Breakout/SR-Matrix v6
// scripts, this one does NOT emit an EXECUTE_LONG/EXECUTE_SHORT webhook
// payload to /api/webhooks/tradingview. Firing a real SML_GAMMA_PIN-tagged
// signal into iam_executor from a script that can only guess at OI (rather
// than the real Tradier-chain-derived max_oi_strike gamma_pin_scanner.py
// already computes) would let a heuristic silently masquerade as the real,
// already-live signal. If a bridge is ever wanted for the manual-override
// path specifically, that needs its own fresh decision and its own distinct
// system tag (e.g. SML_GAMMA_PIN_MANUAL) — not built here.
//
// The alertcondition()s below are informational ("possible pin zone,
// go check the real signal") — not trade-execution alerts.
// =============================================================================
//@version=6
indicator("SML GAMMA PIN v6", shorttitle="SMLGammaPin",
     overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=500)

// ═══ INPUTS ══════════════════════════════════════════════════════════════════
grpE = "Expiry Calendar (real calendar math, not a proxy)"
useWeeklies  = input.bool(true, "Include weekly (every Friday) expiries", group=grpE)
useMonthlies = input.bool(true, "Include monthly (3rd Friday) expiries", group=grpE)
dteWindow    = input.int(2, "Pin-risk DTE window (0..N days)", minval=0, maxval=10, group=grpE,
     tooltip="Matches GAMMA_PIN_MAX_EXPIRATIONS/detect_pin_risk()'s real 0-2 DTE default server-side.")

grpS = "Strike Reference (grid is a PROXY — manual override is real data)"
useManual     = input.bool(false, "Use manual strike (real, from /api/gamma-pin/<symbol> or your broker)", group=grpS)
manualStrike  = input.float(0.0, "Manual max-OI strike", minval=0.0, step=0.5, group=grpS)
proximityPct  = input.float(0.5, "Pin proximity band (%)", minval=0.05, maxval=5.0, step=0.05, group=grpS,
     tooltip="Matches detect_pin_risk()'s real 0.5% max-OI-strike proximity threshold server-side.")

grpD = "Display"
showGrid   = input.bool(true, "Show strike grid", group=grpD)
showZone   = input.bool(true, "Highlight possible pin zone", group=grpD)
showTable  = input.bool(true, "HUD table", group=grpD)
tblPosIn   = input.string("top_right", "Table position",
     options=["top_right", "top_left", "bottom_right", "bottom_left"], group=grpD)

// ═══ BRIGHT PALETTE (no grey) ════════════════════════════════════════════════
cGrid   = color.new(#7CFFB2, 70)   // mint grid lines
cZoneUp = color.new(#00FF66, 88)   // magnet above price
cZoneDn = color.new(#FF1744, 88)   // magnet below price
cManual = #00F5FF                 // cyan — manual/real override
cTblBg  = #050510
cTblBd  = #00F5FF
cTxt    = #FFFFFF
cDim    = #7CFFB2
cWarn   = #FFB300

// ═══ EXPIRY CALENDAR (real, exact — no proxy) ════════════════════════════════
// Next weekly Friday DTE, from today's real day-of-week.
f_dteToNextFriday() =>
    dow = dayofweek(time)                         // dayofweek.sunday=1 .. saturday=7
    diff = (dayofweek.friday - dow + 7) % 7
    diff

// Next monthly 3rd-Friday DTE. 3rd Friday = first Friday of the month + 14
// calendar days. First Friday's day-of-month is derived from the 1st's
// real day-of-week — no lookahead, no invented calendar.
f_thirdFridayDayOfMonth(y, m) =>
    firstDow = dayofweek(timestamp(y, m, 1, 0, 0))
    firstFriday = 1 + ((dayofweek.friday - firstDow + 7) % 7)
    firstFriday + 14

f_dteToNextMonthly() =>
    y = year(time)
    m = month(time)
    d = dayofmonth(time)
    thisThirdFri = f_thirdFridayDayOfMonth(y, m)
    // Default: this month's 3rd Friday hasn't passed yet.
    int targetY = y
    int targetM = m
    int targetD = thisThirdFri
    if d > thisThirdFri
        // This month's 3rd Friday already passed -- roll to next month.
        nm = m == 12 ? 1 : m + 1
        ny = m == 12 ? y + 1 : y
        targetY := ny
        targetM := nm
        targetD := f_thirdFridayDayOfMonth(ny, nm)
    targetTs = timestamp(targetY, targetM, targetD, 16, 0)   // 4pm ET close convention
    todayTs  = timestamp(y, m, d, 16, 0)
    int(math.round((targetTs - todayTs) / 86400000.0))

dteWeekly  = useWeeklies  ? f_dteToNextFriday()    : na
dteMonthly = useMonthlies ? f_dteToNextMonthly()   : na

// int() wrap keeps display clean -- math.min() upcasts to float otherwise.
nearestDte = int(na(dteWeekly) ? dteMonthly : (na(dteMonthly) ? dteWeekly : math.min(dteWeekly, dteMonthly)))
bool inDteWindow = not na(nearestDte) and nearestDte >= 0 and nearestDte <= dteWindow

// ═══ STRIKE REFERENCE ════════════════════════════════════════════════════════
// Auto grid increment -- the >200/>25/>5 tiers are the same real thresholds
// gamma_flow_engine.py's _update_gamma_pressure() already uses server-side
// (tuned for the price range Tradier's real US equity/ETF option chains
// actually cover). Two tiers were ADDED above that -- not present server-side
// -- because a flat $10 increment stops being a meaningful proximity
// reference once price gets large: on BTCUSD (~$64k), $10 is only ~0.016%
// of price, so the 0.5% proximity band below was satisfied on nearly every
// bar (confirmed by testing this script on BTCUSD -- dense, near-constant
// "PIN ZONE" labels, not a real signal, just the grid being too fine for
// the price scale). These two tiers keep the grid proportionally
// meaningful at higher prices; they do NOT make the strike itself any more
// real -- it's still a round-number proxy, and instruments in this price
// range (crypto pairs, some large indices) usually have no Tradier options
// chain at all, so GET /api/gamma-pin/<symbol> would just 503 for them.
// This script's expiry/strike math stays well-defined on any symbol, but is
// only meaningfully tied to a real options chain for the US equities/ETFs
// Tradier actually covers.
f_gridIncrement(spot) =>
    spot > 10000 ? 500.0 : spot > 2000 ? 100.0 : spot > 200 ? 10.0 : spot > 25 ? 2.5 : spot > 5 ? 1.0 : 0.5

gridInc = f_gridIncrement(close)
gridBelow = math.floor(close / gridInc) * gridInc
gridAbove = gridBelow + gridInc
nearestGridStrike = (close - gridBelow) < (gridAbove - close) ? gridBelow : gridAbove

referenceStrike = useManual and manualStrike > 0 ? manualStrike : nearestGridStrike
usingRealStrike = useManual and manualStrike > 0

bool inProximityBand = math.abs(close - referenceStrike) / close * 100.0 < proximityPct
bool possiblePinZone = inDteWindow and inProximityBand

string direction = na
if possiblePinZone
    direction := referenceStrike > close ? "UP (toward strike)" : referenceStrike < close ? "DOWN (toward strike)" : "AT STRIKE"

// ═══ PLOTS ════════════════════════════════════════════════════════════════════
plot(showGrid and not usingRealStrike ? gridBelow : na, "Grid below (proxy)", color=cGrid, style=plot.style_circles)
plot(showGrid and not usingRealStrike ? gridAbove : na, "Grid above (proxy)", color=cGrid, style=plot.style_circles)
plot(usingRealStrike ? referenceStrike : na, "Manual strike (real)", color=cManual, linewidth=2, style=plot.style_linebr)

bgcolor(showZone and possiblePinZone ? (referenceStrike >= close ? cZoneUp : cZoneDn) : na, title="Possible pin zone")

// ta.change() needs a numeric series -- bool is cast to float explicitly
// rather than relying on implicit bool->float coercion.
float pinZoneNum = possiblePinZone ? 1.0 : 0.0
float pinZoneChange = ta.change(pinZoneNum)
bool pinZoneEntered = pinZoneChange == 1
bool pinZoneExited  = pinZoneChange == -1

if pinZoneEntered and barstate.isconfirmed
    label.new(bar_index, high, "PIN ZONE\n" + str.tostring(nearestDte) + "DTE\n" +
         (usingRealStrike ? "real strike " : "grid ~") + str.tostring(referenceStrike, format.mintick),
         style=label.style_label_down, color=usingRealStrike ? cManual : cGrid, textcolor=#000000, size=size.tiny)

// ═══ HUD TABLE ════════════════════════════════════════════════════════════════
f_row(table t, int r, string k, string v, color vc) =>
    table.cell(t, 0, r, k, text_color=cDim, text_size=size.normal, bgcolor=cTblBg)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.normal, bgcolor=cTblBg)

var table hud = na
if showTable and barstate.islast
    tablePos = tblPosIn == "top_left" ? position.top_left :
         tblPosIn == "bottom_right" ? position.bottom_right :
         tblPosIn == "bottom_left" ? position.bottom_left : position.top_right
    if not na(hud)
        table.delete(hud)
    hud := table.new(tablePos, 2, 9, bgcolor=cTblBg, border_color=cTblBd, border_width=2,
         frame_color=cTblBd, frame_width=1)

    table.cell(hud, 0, 0, "GAMMA PIN", text_color=cManual, text_size=size.normal, bgcolor=cTblBg)
    table.cell(hud, 1, 0, "v6 (reference only)", text_color=cWarn, text_size=size.normal, bgcolor=cTblBg)

    f_row(hud, 1, "NEAREST EXPIRY", na(nearestDte) ? "—" : (str.tostring(nearestDte) + " DTE"), inDteWindow ? cManual : cDim)
    f_row(hud, 2, "STRIKE SOURCE", usingRealStrike ? "MANUAL (real)" : "GRID (proxy)", usingRealStrike ? cManual : cWarn)
    f_row(hud, 3, "REFERENCE STRIKE", str.tostring(referenceStrike, format.mintick), cManual)
    f_row(hud, 4, "DIST TO STRIKE", str.tostring(math.abs(close - referenceStrike) / close * 100.0, "#.##") + "%", inProximityBand ? cManual : cDim)
    f_row(hud, 5, "PIN ZONE", possiblePinZone ? "YES — " + direction : "no", possiblePinZone ? (referenceStrike >= close ? color.new(#00FF66, 0) : color.new(#FF1744, 0)) : cDim)
    f_row(hud, 6, "DATA", usingRealStrike ? "real strike, real calendar" : "PROXY grid, real calendar", usingRealStrike ? cManual : cWarn)
    f_row(hud, 7, "REAL SIGNAL", "GET /api/gamma-pin/<symbol>", cWarn)
    f_row(hud, 8, "EXECUTION", "NONE — reference only, no webhook bridge", cWarn)

// ═══ ALERTS (informational — NOT execution signals) ══════════════════════════
alertcondition(pinZoneEntered, "Possible pin zone entered",
     "{{ticker}} entered a POSSIBLE gamma pin zone ({{close}}) — reference only, check GET /api/gamma-pin/{{ticker}} for the real signal before acting.")
alertcondition(pinZoneExited, "Possible pin zone exited",
     "{{ticker}} exited the possible gamma pin zone ({{close}}).")
