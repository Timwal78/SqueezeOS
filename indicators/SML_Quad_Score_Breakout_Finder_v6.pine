//@version=6
// ============================================================================
// SML Quad-Score Explosive Breakout Finder v6 — ScriptMaster / SqueezeOS
// ============================================================================
// Long-only 4-pillar scoring system (operator-provided quantitative spec,
// 2026-07-31). Same convention as every other v6 script here: this is a
// VISUAL of the math — quad_score_engine.py (Python) is the single source
// of truth, run server-side with no TradingView dependency at all via
// quad_score_scanner.py, registered at GET /api/quad-score.
//
// FOUR PILLAR SCORES (0-100 each):
//   COMPRESSION (30/25/20/15/10): BB-width percentile (inverted), Keltner
//     compression (boolean: BB fully inside KC), ATR percentile (inverted),
//     Donchian-width percentile (inverted), 20-bar log-return HV percentile
//     (inverted) — "inverted" means 100-PercentRank, so TIGHTER = HIGHER.
//   TREND (40/30/30): EMA20/50/200 alignment (100/50/0 tiered), a rolling
//     20-bar VWAP position score (disclosed proxy for a genuinely
//     event-anchored VWAP — daily bars have no intraday anchor point),
//     ADX14 strength.
//   PARTICIPATION (40/30/30): Relative Volume, OBV slope percentile
//     (percentile rank is scale-invariant, no separate volume
//     normalization needed), Chaikin Money Flow.
//   TRIGGER (40/30/30): 5-bar momentum acceleration percentile, breakout
//     confirmation vs the PRIOR 20-bar high (no lookahead — today's own
//     high excluded), candle structure (close-location-value).
//
// COMPOSITE = 0.25*Compression + 0.35*Trend + 0.20*Participation +
// 0.20*Trigger.
//
// ENTRY (long-only): Composite>=65 AND Trend>=45 AND Trigger>=45 AND
// Compression cleared 55 at least once in the 10 bars strictly before
// entry (temporal sequence gate) AND the Weekly macro regime is bullish
// (Weekly Close > Weekly EMA200 AND Weekly ADX14 > 18). Stop = ATR*1.5,
// Target = ATR*3.0. These are the TRAIN/VALID-VALIDATED thresholds from
// docs/QUAD_SCORE_OPTIMIZATION_2026-07-31.md, NOT the operator's originally
// specified defaults (Composite>=70/Trend>=50/Trigger>=60/temporal>=65/
// ATR-stop=2.0/ATR-tp=4.0 — see docs/QUAD_SCORE_BACKTEST_2026-07-31.md for
// that shipped-defaults result, mixed-but-thin on only 6 symbols). A
// 3000-config chronological search across 16 real symbols (2018-2026)
// found this looser, more selective-yet-more-productive config instead:
// 146 trades, PF 1.989, held up out-of-sample across four different split
// points and under single-parameter perturbation in all six tuned
// dimensions. Every input remains fully adjustable; these are just the
// evidence-backed starting values now.
//
// MACRO REGIME — NO REPAINT: read via request.security(..., "W", expr[1],
// lookahead=barmerge.lookahead_off) — the [1] offset means every daily bar
// only ever sees the last FULLY COMPLETED prior week's regime, never the
// still-forming current week. Same no-lookahead guarantee as the Python
// engine's own _weekly_macro_series().
//
// Needs real ~4+ years of history for Weekly EMA200 to mean anything —
// this is inherent to the design (a real macro filter, not a proxy), not a
// bug. Not added to IAM_PRIMARY_SYSTEM by this build — this trades on
// PAPER only out of the box via the Python scanner, same as every other
// engine here; going live is a separate, explicit operator decision.
// ============================================================================
strategy("SML Quad-Score Explosive Breakout Finder v6", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.03, slippage=1)

// ==========================================
// COLOR PALETTE (JET BLACK & NEON)
// ==========================================
color C_BLACK  = #000000
color C_WHITE  = #FFFFFF
color C_NEON   = #00FF66
color C_RED    = #FF0055
color C_ORANGE = #FF9900
color C_CYAN   = #00E5FF
color C_PURPLE = #B084FF
color C_DIM    = color.new(#8899AA, 70)

bgcolor(C_BLACK, title="Jet Black Background")

// ==========================================
// INPUTS
// ==========================================
var string G_COMP = "Compression (Pillar 1)"
bbLength       = input.int(20, "BB Length", minval=5, group=G_COMP)
bbMult         = input.float(2.0, "BB Multiplier", minval=0.1, step=0.1, group=G_COMP)
kcEmaLength    = input.int(20, "Keltner EMA Length", minval=5, group=G_COMP)
kcAtrMult      = input.float(1.5, "Keltner ATR Multiplier", minval=0.1, step=0.1, group=G_COMP)
atrLength      = input.int(14, "ATR Length", minval=2, group=G_COMP)
donchianLength = input.int(20, "Donchian Length", minval=5, group=G_COMP)
hvLength       = input.int(20, "Historical Vol Length", minval=5, group=G_COMP)
pctileWindow   = input.int(100, "Percentile Rank Window (N)", minval=20, group=G_COMP)

var string G_TREND = "Trend (Pillar 2)"
emaFastLen  = input.int(20, "EMA Fast", minval=2, group=G_TREND)
emaMidLen   = input.int(50, "EMA Mid", minval=2, group=G_TREND)
emaSlowLen  = input.int(200, "EMA Slow", minval=2, group=G_TREND)
avwapLength = input.int(20, "Rolling VWAP Length", minval=2, group=G_TREND)
adxLength   = input.int(14, "ADX Length", minval=2, group=G_TREND)

var string G_PART = "Participation (Pillar 3)"
rvolLength   = input.int(20, "RVOL Avg Length", minval=2, group=G_PART)
rvolDivisor  = input.float(3.0, "RVOL Divisor (maps to 100)", minval=0.5, step=0.1, group=G_PART)
obvSlopeLen  = input.int(14, "OBV Slope Length", minval=2, group=G_PART)
cmfLength    = input.int(20, "CMF Length", minval=2, group=G_PART)

var string G_TRIG = "Trigger (Pillar 4)"
momLen = input.int(5, "Momentum Length", minval=1, group=G_TRIG)

var string G_MACRO = "Macro HTF Regime (Weekly)"
weeklyEmaLen   = input.int(200, "Weekly EMA Length", minval=10, group=G_MACRO)
weeklyAdxLen   = input.int(14, "Weekly ADX Length", minval=2, group=G_MACRO)
weeklyAdxMin   = input.float(18.0, "Weekly ADX Minimum", minval=0.0, step=0.5, group=G_MACRO)

var string G_RISK = "Risk (ATR-based stop/target)"
atrStopMult = input.float(1.5, "ATR Stop Multiplier", minval=0.5, step=0.1, group=G_RISK)
atrTpMult   = input.float(3.0, "ATR Target Multiplier", minval=0.5, step=0.1, group=G_RISK)

var string G_GATE = "Entry Gate Thresholds"
thComposite        = input.float(65.0, "Min Composite Score", minval=0.0, maxval=100.0, group=G_GATE)
thTrend            = input.float(45.0, "Min Trend Score", minval=0.0, maxval=100.0, group=G_GATE)
thTrigger          = input.float(45.0, "Min Trigger Score", minval=0.0, maxval=100.0, group=G_GATE)
temporalLookback   = input.int(10, "Temporal Gate Lookback (bars)", minval=1, group=G_GATE)
temporalThreshold  = input.float(55.0, "Temporal Gate Compression Min", minval=0.0, maxval=100.0, group=G_GATE)

var string G_VISUAL = "Visuals"
showBands   = input.bool(true, "Plot BB / KC Bands?", group=G_VISUAL)
showComposite = input.bool(true, "Plot Composite Histogram Pane?", group=G_VISUAL)
showCompBg  = input.bool(true, "Highlight Compression Background?", group=G_VISUAL)

var string G_WEBHOOK = "Webhook Bridge (optional — native Python engine is the production path)"
whPass = input.string("", "Webhook Passphrase", group=G_WEBHOOK, tooltip="STEP 1 of 2: type any password here (make one up, e.g. MyPass123) — this box is empty by default, so no signals are sent until you fill it in. STEP 2: copy that exact same password into the TV_WEBHOOK_PASSPHRASE environment variable on the squeezeos-api Render service, then create ONE TradingView alert on this indicator (clock icon, top toolbar) with Condition = 'Any alert() function call', paste https://squeezeos-api.onrender.com/api/webhooks/tradingview into the Webhook URL field under Notifications, and leave the alert's Message box untouched — this script builds the JSON itself. This is a redundant, optional second path — quad_score_scanner.py already runs this exact strategy natively server-side with no TradingView dependency at all.")

// ==========================================
// PILLAR 1: COMPRESSION
// ==========================================
basisBB = ta.sma(close, bbLength)
devBB   = bbMult * ta.stdev(close, bbLength)
upperBB = basisBB + devBB
lowerBB = basisBB - devBB
bbw     = (upperBB - lowerBB) / basisBB

atrVal  = ta.atr(atrLength)
kcBasis = ta.ema(close, kcEmaLength)
upperKC = kcBasis + atrVal * kcAtrMult
lowerKC = kcBasis - atrVal * kcAtrMult
kcScore = (upperBB <= upperKC and lowerBB >= lowerKC) ? 100.0 : 0.0

donHigh = ta.highest(high, donchianLength)
donLow  = ta.lowest(low, donchianLength)
dw      = (donHigh - donLow) / close

logRet = math.log(close / close[1])
hv     = ta.stdev(logRet, hvLength) * math.sqrt(252)

bbwPctile = ta.percentrank(bbw, pctileWindow)
atrPctile = ta.percentrank(atrVal, pctileWindow)
dwPctile  = ta.percentrank(dw, pctileWindow)
hvPctile  = ta.percentrank(hv, pctileWindow)

sComp = 0.30 * (100.0 - bbwPctile) + 0.25 * kcScore + 0.20 * (100.0 - atrPctile) + 0.15 * (100.0 - dwPctile) + 0.10 * (100.0 - hvPctile)

// ==========================================
// PILLAR 2: TREND
// ==========================================
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLength, adxLength)

vwapVal = ta.sma(hlc3 * volume, avwapLength) / ta.sma(volume, avwapLength)

emaAlign   = (emaFast > emaMid and emaMid > emaSlow) ? 100.0 : (emaFast > emaMid ? 50.0 : 0.0)
distPct    = (close - vwapVal) / vwapVal * 100.0
avwapScore = math.max(0.0, math.min(100.0, 50.0 + distPct * 10.0))
adxScore   = math.min(100.0, adxVal / 50.0 * 100.0)

sTrend = 0.40 * emaAlign + 0.30 * avwapScore + 0.30 * adxScore

// ==========================================
// PILLAR 3: PARTICIPATION
// ==========================================
volAvg = ta.sma(volume, rvolLength)
rvol   = volAvg > 0 ? volume / volAvg : 1.0
rvolScore = math.min(100.0, rvol / rvolDivisor * 100.0)

var float obv = 0.0
obv := close > close[1] ? obv + volume : close < close[1] ? obv - volume : obv
obvSlope   = ta.linreg(obv, obvSlopeLen, 0) - ta.linreg(obv, obvSlopeLen, 1)
obvPctile  = ta.percentrank(obvSlope, pctileWindow)

mfm = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
mfv = mfm * volume
cmfVal   = ta.sma(mfv, cmfLength) / ta.sma(volume, cmfLength)
cmfScore = math.max(0.0, math.min(100.0, (cmfVal + 0.5) * 100.0))

sPart = 0.40 * rvolScore + 0.30 * obvPctile + 0.30 * cmfScore

// ==========================================
// PILLAR 4: TRIGGER
// ==========================================
mom5  = close - close[momLen]
accel = mom5 - mom5[1]
accelPctile = ta.percentrank(accel, pctileWindow)

priorHigh = donHigh[1]
brkScore  = close > priorHigh ? 100.0 : (close > emaFast ? 50.0 : 0.0)
candleScore = (high - low) != 0 ? (close - low) / (high - low) * 100.0 : 50.0

sTrig = 0.40 * accelPctile + 0.30 * brkScore + 0.30 * candleScore

// ==========================================
// COMPOSITE + GATES
// ==========================================
sComposite = 0.25 * sComp + 0.35 * sTrend + 0.20 * sPart + 0.20 * sTrig

// Temporal sequence gate: was compression >= threshold at least once in
// the `temporalLookback` bars strictly BEFORE this one? ta.highest(sComp[1],
// N) looks at sComp[1]..sComp[N] relative to the current bar -- exactly
// the window strictly before, current bar's own sComp excluded.
compressionMaxPrior = ta.highest(sComp[1], temporalLookback)
temporalValid = compressionMaxPrior >= temporalThreshold

// Macro HTF regime -- the whole expression is evaluated INSIDE
// request.security's "W" context via this local function, so ta.ema/
// ta.dmi/close here all correctly resolve against WEEKLY bars, not a
// 200/14-DAY calculation mislabeled as weekly. Pulled back with a [1]
// offset so a daily bar only ever sees the last FULLY COMPLETED prior
// week (never the still-forming current week: no repaint, no lookahead,
// exactly mirroring quad_score_engine.py's own guarantee).
htf_valid() =>
    htfEma = ta.ema(close, weeklyEmaLen)
    [diP, diM, htfAdx] = ta.dmi(weeklyAdxLen, weeklyAdxLen)
    close > htfEma and htfAdx > weeklyAdxMin

macroValid = request.security(syminfo.tickerid, "W", htf_valid()[1], lookahead=barmerge.lookahead_off)

entrySignal = sComposite >= thComposite and sTrend >= thTrend and sTrig >= thTrigger and temporalValid and macroValid

// ==========================================
// EXECUTION & WEBHOOK BRIDGE
// ==========================================
var float stopPrice   = na
var float targetPrice = na

f_whJson(_act) =>
    '{"passphrase":"' + whPass + '","system":"SML_QUAD_SCORE","ticker":"' + syminfo.ticker + '","action":"' + _act + '","price":' + str.tostring(close, "#.####") + ',"score":' + str.tostring(sComposite, "#.#") + '}'

if entrySignal and strategy.position_size == 0
    stopPrice   := close - atrVal * atrStopMult
    targetPrice := close + atrVal * atrTpMult
    strategy.entry("QS_Long", strategy.long)
    strategy.exit("QS_Exit", "QS_Long", stop=stopPrice, limit=targetPrice)
    label.new(bar_index, low, "QS\n" + str.tostring(math.round(sComposite)), style=label.style_label_up, color=C_NEON, textcolor=C_BLACK, size=size.small)
    if barstate.isconfirmed and whPass != ""
        alert(f_whJson("EXECUTE_LONG"), alert.freq_once_per_bar_close)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    stopPrice   := na
    targetPrice := na

// ==========================================
// ON-CHART VISUALS
// ==========================================
plotchar(entrySignal and strategy.position_size == 0, title="Quad-Score Entry", char="▲", location=location.belowbar, color=C_NEON, size=size.tiny)

plot(emaFast, "EMA Fast", color=color.new(C_CYAN, 40), linewidth=1)
plot(emaMid, "EMA Mid", color=color.new(C_PURPLE, 30), linewidth=1)
plot(emaSlow, "EMA Slow (Macro)", color=C_ORANGE, linewidth=2)

pUpperBB = plot(showBands ? upperBB : na, "Upper BB", color=color.new(C_CYAN, 40), linewidth=1)
pLowerBB = plot(showBands ? lowerBB : na, "Lower BB", color=color.new(C_CYAN, 40), linewidth=1)
pUpperKC = plot(showBands ? upperKC : na, "Upper KC", color=color.new(C_PURPLE, 40), linewidth=1)
pLowerKC = plot(showBands ? lowerKC : na, "Lower KC", color=color.new(C_PURPLE, 40), linewidth=1)
fill(pUpperBB, pUpperKC, color=color.new(C_PURPLE, 92), title="BB/KC Compression Fill (upper)")
fill(pLowerBB, pLowerKC, color=color.new(C_PURPLE, 92), title="BB/KC Compression Fill (lower)")

bgcolor(showCompBg and sComp >= temporalThreshold ? C_DIM : na, title="Compression Highlight")

plot(showComposite ? sComposite : na, "Composite Score", style=plot.style_columns,
     color=sComposite >= thComposite ? C_NEON : color.new(C_WHITE, 60), display=display.pane)
hline(70, "Composite Threshold", color=color.new(C_RED, 50), linestyle=hline.style_dashed)

// ==========================================
// SMART HUD TABLE (JET BLACK / BRIGHT WHITE TEXT)
// ==========================================
var table hud = table.new(position=position.top_right, columns=2, rows=10, bgcolor=C_BLACK, border_color=C_BLACK, border_width=1)

if barstate.islast
    color compColor  = sComp >= temporalThreshold ? C_NEON : C_WHITE
    color trendColor = sTrend >= thTrend ? C_NEON : C_WHITE
    color partColor  = sPart >= 50.0 ? C_NEON : C_WHITE
    color trigColor  = sTrig >= thTrigger ? C_NEON : C_WHITE
    color compositeColor = sComposite >= thComposite ? C_NEON : C_RED
    color temporalColor  = temporalValid ? C_NEON : C_RED
    color macroColor     = macroValid ? C_NEON : C_RED

    table.cell(hud, 0, 0, "QUAD-SCORE FINDER v6", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 0, "METRIC", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)

    table.cell(hud, 0, 1, "COMPRESSION", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 1, str.tostring(sComp, "#.#") + " / 100", bgcolor=C_BLACK, text_color=compColor, text_size=size.normal)

    table.cell(hud, 0, 2, "TREND", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 2, str.tostring(sTrend, "#.#") + " / 100", bgcolor=C_BLACK, text_color=trendColor, text_size=size.normal)

    table.cell(hud, 0, 3, "PARTICIPATION", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 3, str.tostring(sPart, "#.#") + " / 100", bgcolor=C_BLACK, text_color=partColor, text_size=size.normal)

    table.cell(hud, 0, 4, "TRIGGER", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 4, str.tostring(sTrig, "#.#") + " / 100", bgcolor=C_BLACK, text_color=trigColor, text_size=size.normal)

    table.cell(hud, 0, 5, "COMPOSITE", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 5, str.tostring(sComposite, "#.#") + " / 100", bgcolor=C_BLACK, text_color=compositeColor, text_size=size.normal)

    table.cell(hud, 0, 6, "TEMPORAL GATE", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 6, temporalValid ? "CLEARED" : "BLOCKED", bgcolor=C_BLACK, text_color=temporalColor, text_size=size.normal)

    table.cell(hud, 0, 7, "MACRO REGIME (WK)", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 7, macroValid ? "BULLISH" : "BLOCKED", bgcolor=C_BLACK, text_color=macroColor, text_size=size.normal)

    table.cell(hud, 0, 8, "STOP / TARGET", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 8, na(stopPrice) ? "—" : str.tostring(stopPrice, "#.##") + " / " + str.tostring(targetPrice, "#.##"), bgcolor=C_BLACK, text_color=C_NEON, text_size=size.normal)

    table.cell(hud, 0, 9, "WEBHOOK BRIDGE", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 9, whPass == "" ? "INACTIVE" : "ARMED", bgcolor=C_BLACK, text_color=whPass == "" ? color.new(C_WHITE, 40) : C_NEON, text_size=size.normal)
