//@version=6
// ============================================================================
// SML Sovereign Squeeze Finder v6 — ScriptMaster / SqueezeOS
// ============================================================================
// Same math as the operator-submitted original (BB-inside-KC compression/
// release + ta.linreg momentum + RVOL spike + 200-EMA trend filter) — the
// Pine ta.linreg() term below was ALREADY correct as originally submitted
// (ta.highest/ta.lowest/ta.sma are genuine per-bar series in Pine, so
// ta.linreg regresses a true rolling deviation series). The bug that was
// found and fixed lived only in this script's Python twin
// (sovereign_squeeze_engine.py), which had mis-modeled that as a single
// constant subtracted from raw closes — see
// docs/SOVEREIGN_SQUEEZE_BACKTEST_2026-07-31.md. This Pine script itself
// needed no math fix.
//
// Defaults below are the real, chronologically-validated config from
// docs/SOVEREIGN_SQUEEZE_OPTIMIZATION_2026-07-31.md (TRAIN(67%)/VALID(33%)
// parameter search over real 2021-2026 daily bars, AMC/GME/IWM/SPY/NVDA/QQQ:
// 96 trades, aggregate PF 2.70, held up out-of-sample across four different
// split points) — NOT the script's originally-submitted defaults
// (bb_length=20/mult=2.0, kc_length=20/mult=1.5, min_sqz_bars=3,
// min_rvol=1.5, rr_ratio=2.5), which measured PF 0.34 on the same data.
// Every input remains fully adjustable; these are just the evidence-backed
// starting values now.
//
// LIVE EXECUTION: the native Python engine (sovereign_squeeze_engine.py /
// sovereign_squeeze_scanner.py, system tag "SML_SOVEREIGN_SQUEEZE") is the
// production path — it runs server-side with no TradingView dependency,
// same convention as every other engine in this codebase. The webhook
// bridge below is an OPTIONAL, redundant second path (same JSON contract
// every other v6 bridge here uses) for anyone who wants a TradingView-alert
// -triggered signal alongside it — both ultimately reach the same
// iam_executor.py, whose cooldown/dedup logic already handles two sources
// firing the same symbol.
// ============================================================================
strategy("ScriptMaster - Sovereign Squeeze Setup Finder v6", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.03, slippage=1)

// ==========================================
// COLOR PALETTE (JET BLACK & NEON - NO GREY)
// ==========================================
color C_BLACK     = #000000 // Absolute Jet Black
color C_WHITE     = #FFFFFF // Pure Bright White
color C_CALL_NEON = #00FF66 // Full Shield Neon Green
color C_PUT_NEON  = #FF0055 // Full Shield Neon Red
color C_ORANGE    = #FF9900 // Macro EMA Orange
color C_CYAN      = #00E5FF // Cyan Highlight
color C_PURPLE    = #B084FF // Keltner Channel Purple
color C_GREY_DIM  = color.new(#8899AA, 70) // squeeze-compression background tint

bgcolor(C_BLACK, title="Jet Black Background")

// ==========================================
// INPUTS & CONFIGURATION
// ==========================================
var string G_SQUEEZE = "Squeeze Parameters (validated defaults — see docs/SOVEREIGN_SQUEEZE_OPTIMIZATION_2026-07-31.md)"
bbLength             = input.int(10, "Bollinger Band Length", minval=5, group=G_SQUEEZE)
bbMult               = input.float(2.5, "BB Multiplier", minval=0.1, step=0.1, group=G_SQUEEZE)
kcLength             = input.int(10, "Keltner Channel Length", minval=5, group=G_SQUEEZE)
kcMult               = input.float(2.0, "KC Multiplier", minval=0.1, step=0.1, group=G_SQUEEZE)
minSqzBars           = input.int(2, "Min Squeeze Compression Bars", minval=1, group=G_SQUEEZE)

var string G_FILTERS = "Quality Filters"
useRvol              = input.bool(true, "Require Volume Spike (RVOL >= threshold)?", group=G_FILTERS)
minRvol              = input.float(1.0, "Min Relative Volume", minval=0.1, step=0.1, group=G_FILTERS)
useMacroEma          = input.bool(true, "Require 200 EMA Trend Filter?", group=G_FILTERS)
macroEmaLen          = input.int(200, "Macro EMA Length", minval=10, group=G_FILTERS)

var string G_RISK    = "Risk & Execution Rules"
rrRatio              = input.float(2.0, "Risk/Reward Ratio (R-Target)", minval=0.5, step=0.1, group=G_RISK)

var string G_VISUAL  = "Visuals"
showBands            = input.bool(true, "Plot BB / KC Bands?", group=G_VISUAL)
showMomHist          = input.bool(true, "Plot Momentum Histogram Pane?", group=G_VISUAL)
showSqzBg            = input.bool(true, "Highlight Squeeze Compression Background?", group=G_VISUAL)

var string G_WEBHOOK = "Webhook Bridge (optional — native Python engine is the production path)"
whPass               = input.string("", "Webhook Passphrase", group=G_WEBHOOK, tooltip="STEP 1 of 2: type any password here (make one up, e.g. MyPass123) — this box is empty by default, so no signals are sent until you fill it in. STEP 2: copy that exact same password into the TV_WEBHOOK_PASSPHRASE environment variable on the squeezeos-api Render service, then create ONE TradingView alert on this indicator (clock icon, top toolbar) with Condition = 'Any alert() function call', paste https://squeezeos-api.onrender.com/api/webhooks/tradingview into the Webhook URL field under Notifications, and leave the alert's Message box untouched — this script builds the JSON itself. This is a redundant, optional second path — sovereign_squeeze_scanner.py already runs this exact strategy natively server-side with no TradingView dependency at all.")

// ==========================================
// SQUEEZE & MOMENTUM CALCULATIONS
// ==========================================
source   = close
basisBB  = ta.sma(source, bbLength)
devBB    = bbMult * ta.stdev(source, bbLength)
upperBB  = basisBB + devBB
lowerBB  = basisBB - devBB

maKC     = ta.sma(source, kcLength)
rangeKC  = ta.sma(ta.tr, kcLength)
upperKC  = maKC + rangeKC * kcMult
lowerKC  = maKC - rangeKC * kcMult

// Squeeze States (Strict Bool Series)
bool sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
bool sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)

// Linear Regression Momentum — a genuine per-bar rolling series (ta.highest/
// ta.lowest/ta.sma each recompute their own trailing kcLength window at
// every bar), so ta.linreg regresses the true deviation series, not a
// constant. This was always correct in Pine; only the Python port needed
// the fix — see file header.
val     = ta.linreg(source - math.avg(math.avg(ta.highest(high, kcLength), ta.lowest(low, kcLength)), ta.sma(close, kcLength)), kcLength, 0)
valPrev = ta.valuewhen(true, val[1], 0)

// Relative Volume & Trend Filter
macroEma = ta.ema(close, macroEmaLen)
volEma   = ta.ema(volume, 20)
rvol     = volEma > 0 ? (volume / volEma) : 1.0

// Tracking Compression Duration
var int sqzBarCount = 0
if sqzOn
    sqzBarCount += 1
else if sqzOff
    sqzBarCount := 0

// ==========================================
// ROOT-SCOPE CALCULATIONS & SIGNAL CONDITIONS
// ==========================================
bool prevSqzOn      = sqzOn[1] == true
int  prevSqzBars    = sqzBarCount[1]

bool sqzFired       = sqzOff and prevSqzOn
bool validSqzLength = prevSqzBars >= minSqzBars
bool rvolPass       = not useRvol or (rvol >= minRvol)

// Long Signal: Squeeze fires off, momentum accelerating upward, close above 200 EMA
bool callSetup = sqzFired and validSqzLength and (val > valPrev) and (val > 0) and rvolPass and (not useMacroEma or close > macroEma)

// Short Signal: Squeeze fires off, momentum accelerating downward, close below 200 EMA
bool putSetup  = sqzFired and validSqzLength and (val < valPrev) and (val < 0) and rvolPass and (not useMacroEma or close < macroEma)

// ==========================================
// SETUP QUALITY SCORE (0 - 100)
// ==========================================
int sqzScore = 0
if callSetup or putSetup
    int scoreLen   = math.min(prevSqzBars * 10, 40)       // Max 40 pts for squeeze compression length
    int scoreVol   = math.min(math.round(rvol * 20), 40)   // Max 40 pts for RVOL spike
    int scoreTrend = (useMacroEma and ((callSetup and close > macroEma) or (putSetup and close < macroEma))) ? 20 : 10
    sqzScore      := math.min(scoreLen + scoreVol + scoreTrend, 100)

// ==========================================
// TRADE EXECUTION, LABELS & WEBHOOK BRIDGE
// ==========================================
var string activeBias = "SEARCHING..."
var float stopPrice   = na
var float targetPrice = na

f_whJson(_act) =>
    '{"passphrase":"' + whPass + '","system":"SML_SOVEREIGN_SQUEEZE","ticker":"' + syminfo.ticker + '","action":"' + _act + '","price":' + str.tostring(close, "#.####") + ',"score":' + str.tostring(sqzScore) + '}'

// ta.lowest/ta.highest called unconditionally on every bar (Pine style rule
// CW10003 — these must be called in the same scope on every calculation for
// consistent internal state), then referenced conditionally below instead of
// calling ta.* directly inside an if block.
lowest3  = ta.lowest(low, 3)
highest3 = ta.highest(high, 3)

if callSetup and strategy.position_size == 0
    activeBias  := "CALL (LONG)"
    stopPrice   := lowest3
    targetPrice := close + ((close - stopPrice) * rrRatio)
    strategy.entry("Sqz_Call", strategy.long)
    strategy.exit("Exit_Call", "Sqz_Call", stop=stopPrice, limit=targetPrice)
    label.new(bar_index, low, "CALL\n" + str.tostring(sqzScore), style=label.style_label_up, color=C_CALL_NEON, textcolor=C_BLACK, size=size.small)
    if barstate.isconfirmed and whPass != ""
        alert(f_whJson("EXECUTE_LONG"), alert.freq_once_per_bar_close)

if putSetup and strategy.position_size == 0
    activeBias  := "PUT (SHORT)"
    stopPrice   := highest3
    targetPrice := close - ((stopPrice - close) * rrRatio)
    strategy.entry("Sqz_Put", strategy.short)
    strategy.exit("Exit_Put", "Sqz_Put", stop=stopPrice, limit=targetPrice)
    label.new(bar_index, high, "PUT\n" + str.tostring(sqzScore), style=label.style_label_down, color=C_PUT_NEON, textcolor=C_WHITE, size=size.small)
    if barstate.isconfirmed and whPass != ""
        alert(f_whJson("EXECUTE_SHORT"), alert.freq_once_per_bar_close)

if ta.change(time("D")) != 0 and timeframe.isintraday
    activeBias  := "SEARCHING..."
    stopPrice   := na
    targetPrice := na

// ==========================================
// ON-CHART VISUALS
// ==========================================
plotchar(callSetup, title="CALL Squeeze Trigger", char="▲", location=location.belowbar, color=C_CALL_NEON, size=size.tiny)
plotchar(putSetup, title="PUT Squeeze Trigger", char="▼", location=location.abovebar, color=C_PUT_NEON, size=size.tiny)

plot(useMacroEma ? macroEma : na, "Macro 200 EMA", color=C_ORANGE, linewidth=2)

pUpperBB = plot(showBands ? upperBB : na, "Upper BB", color=color.new(C_CYAN, 40), linewidth=1)
pLowerBB = plot(showBands ? lowerBB : na, "Lower BB", color=color.new(C_CYAN, 40), linewidth=1)
pUpperKC = plot(showBands ? upperKC : na, "Upper KC", color=color.new(C_PURPLE, 40), linewidth=1)
pLowerKC = plot(showBands ? lowerKC : na, "Lower KC", color=color.new(C_PURPLE, 40), linewidth=1)
fill(pUpperBB, pUpperKC, color=color.new(C_PURPLE, 92), title="BB/KC Squeeze Fill (upper)")
fill(pLowerBB, pLowerKC, color=color.new(C_PURPLE, 92), title="BB/KC Squeeze Fill (lower)")

bgcolor(showSqzBg and sqzOn ? C_GREY_DIM : na, title="Squeeze Compression Highlight")

// Momentum histogram — separate pane, coloured by direction + acceleration
plot(showMomHist ? val : na, "Squeeze Momentum", style=plot.style_columns,
     color=val > 0 ? (val > valPrev ? C_CALL_NEON : color.new(C_CALL_NEON, 60)) : (val < valPrev ? C_PUT_NEON : color.new(C_PUT_NEON, 60)),
     display=display.pane)
hline(0, "Zero Line", color=color.new(C_WHITE, 70), linestyle=hline.style_dotted)

// ==========================================
// SMART HUD TABLE (JET BLACK / BRIGHT WHITE TEXT)
// ==========================================
var table hud = table.new(position = position.top_right, columns = 2, rows = 9, bgcolor = C_BLACK, border_color = C_BLACK, border_width = 1)

if barstate.islast
    color statusColor = activeBias == "CALL (LONG)" ? C_CALL_NEON : activeBias == "PUT (SHORT)" ? C_PUT_NEON : C_WHITE
    string trendState = not useMacroEma ? "OFF" : close > macroEma ? "BULL (>200EMA)" : "BEAR (<200EMA)"
    color trendColor  = not useMacroEma ? C_WHITE : close > macroEma ? C_CALL_NEON : C_PUT_NEON
    string momState   = val > 0 ? (val > valPrev ? "RISING+" : "FADING+") : (val < valPrev ? "FALLING-" : "FADING-")

    table.cell(hud, 0, 0, "SOVEREIGN FINDER v6", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 0, "METRIC", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)

    table.cell(hud, 0, 1, "SQUEEZE STATE", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 1, sqzOn ? "COILING (" + str.tostring(sqzBarCount) + "b)" : "RELEASED", bgcolor=C_BLACK, text_color=sqzOn ? C_ORANGE : C_CYAN, text_size=size.normal)

    table.cell(hud, 0, 2, "SETUP BIAS", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 2, activeBias, bgcolor=C_BLACK, text_color=statusColor, text_size=size.normal)

    table.cell(hud, 0, 3, "SETUP SCORE", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 3, str.tostring(sqzScore) + " / 100", bgcolor=C_BLACK, text_color=sqzScore >= 70 ? C_CALL_NEON : C_WHITE, text_size=size.normal)

    table.cell(hud, 0, 4, "MOMENTUM", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 4, momState, bgcolor=C_BLACK, text_color=val > 0 ? C_CALL_NEON : C_PUT_NEON, text_size=size.normal)

    table.cell(hud, 0, 5, "RVOL EXPANSION", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 5, str.tostring(rvol, "#.##") + "x", bgcolor=C_BLACK, text_color=rvol >= minRvol ? C_CALL_NEON : C_WHITE, text_size=size.normal)

    table.cell(hud, 0, 6, "MACRO TREND", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 6, trendState, bgcolor=C_BLACK, text_color=trendColor, text_size=size.normal)

    table.cell(hud, 0, 7, "STOP / TARGET", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 7, na(stopPrice) ? "—" : str.tostring(stopPrice, "#.##") + " / " + str.tostring(targetPrice, "#.##"), bgcolor=C_BLACK, text_color=C_CALL_NEON, text_size=size.normal)

    table.cell(hud, 0, 8, "WEBHOOK BRIDGE", bgcolor=C_BLACK, text_color=C_WHITE, text_size=size.normal)
    table.cell(hud, 1, 8, whPass == "" ? "INACTIVE" : "ARMED", bgcolor=C_BLACK, text_color=whPass == "" ? color.new(C_WHITE, 40) : C_CALL_NEON, text_size=size.normal)
