//@version=6
indicator("SML Market Maker Intelligence™ v4 [ScriptMasterLabs]", shorttitle="SML MM v4", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  SML MARKET MAKER INTELLIGENCE™ v4  ·  ScriptMasterLabs                   ║
// ║  Institutional Inventory + Gamma Pressure + Forced Hedge Detection         ║
// ║  Plain English Dashboard · HJB Optimal Control · Kalman Filtered           ║
// ║  © ScriptMasterLabs — Invite Only                                          ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
//
// Pine visual of mm_intel_engine.py (SqueezeOS repo) -- Python is the single
// source of truth, same convention as imo_engine.py/druck_engine.py/etc.
// The Kalman inventory filter + HJB Riccati hedge-rate math here is a near-
// exact match to logic already live server-side in gamma_flow_engine.py's
// embedded "MM Intel v3" section (_update_mm_intel()/_update_gamma_pressure(),
// same MM_KALMAN_GAIN/MM_KALMAN_LAMBDA/MM_INV_HOLD_COST/MM_MARKET_IMPACT env
// vars) -- that logic previously had no Pine visual companion in this repo.
//
// Gamma-pressure/strike-magnet section is a round-number/volume PROXY for
// dealer gamma, not a calculation from real options-chain OI -- same
// disclosed-proxy class as SML_Gamma_Pin_v6.pine's grid, not a duplicate of
// it: this script's long/short_signal answers "is dealer inventory stressed
// enough right now to force a hedge," Gamma Pin answers "is price pinned
// near a strike right before expiry." Complementary, not competing.
//
// Backtest verdict: see docs/MM_INTEL_BACKTEST_2026-07-25.md (real OHLCV,
// no options-chain data needed since inv_z/gamma_pressure are OHLCV-derived).
//
// Known issue found while porting to Python (kept as-submitted here, NOT
// silently altered -- fixed in mm_intel_engine.py instead, see that
// module's docstring): Section 6B's invalidation check runs immediately
// after setting active_direction/active_invalidation on the SAME bar, using
// the SAME sign that just triggered entry -- a long enters because
// inv_z < -z_critical, which already satisfies its own "inv_z <= 0" resolve
// check a few lines later, so active_direction/active_invalidation
// self-resets on the very same bar it's set and can't visibly persist
// across bars on the chart the way the dashboard implies. The Python engine
// is the source of truth and carries the fix; this Pine script is left
// exactly as submitted.

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 1: PARAMETERS
// ═══════════════════════════════════════════════════════════════════════════════
grp_dyn = "═══ Dynamics ═══"
lambda = input.float(0.15, "Mean Reversion Speed", minval=0.01, maxval=1.0, step=0.01, group=grp_dyn, tooltip="How fast MM inventory reverts to zero. Higher = faster rebalance.")
q_process = input.float(0.5, "Process Noise (Q)", minval=0.05, maxval=5.0, step=0.05, group=grp_dyn, tooltip="How much you trust the mean-reversion MODEL itself. Higher = filter adapts faster to new inventory levels but is jumpier.")
r_measurement = input.float(1.0, "Measurement Noise (R)", minval=0.1, maxval=5.0, step=0.1, group=grp_dyn, tooltip="How noisy you believe the raw order-flow MEASUREMENT is. Higher = filter trusts the model over the latest bar's flow, giving smoother but slower output. Q and R are kept separate — using the same value for both (as in prior versions) collapses this into a simple smoother instead of a real adaptive Kalman filter.")
inv_lookback = input.int(75, "Inventory Memory (bars)", minval=20, maxval=500, group=grp_dyn, tooltip="Optimized for high-velocity 0DTE response.")

grp_cost = "═══ HJB Cost Function ═══"
c_inv = input.float(0.1, "Inventory Holding Cost", minval=0.01, maxval=1.0, step=0.01, group=grp_cost, tooltip="Penalty for holding inventory. Higher = MM hedges faster.")
kappa_impact = input.float(0.5, "Market Impact Cost", minval=0.1, maxval=2.0, step=0.1, group=grp_cost, tooltip="Cost of moving the market when hedging. Higher = smaller hedges.")
gamma_term = input.float(1.0, "Terminal Penalty", minval=0.1, maxval=5.0, step=0.1, group=grp_cost, tooltip="End-of-period inventory penalty. Higher = more aggressive unwind targets.")

grp_crit = "═══ Sensitivity ═══"
sensitivity = input.string("Normal", "Signal Sensitivity", options=["Strict","Normal","Sensitive","Aggressive"], group=grp_crit, tooltip="Strict = highest conviction. Normal = balanced. Sensitive = catches more 0DTE setups.")
man_z_crit = input.float(0, "Z-Score Override (0=Auto)", minval=0, maxval=4.0, step=0.1, group=grp_crit)
man_gamma = input.float(0, "Gamma Override (0=Auto)", minval=0, maxval=2.0, step=0.1, group=grp_crit)

z_critical = man_z_crit > 0 ? man_z_crit : sensitivity == "Strict" ? 2.5 : sensitivity == "Normal" ? 2.0 : sensitivity == "Sensitive" ? 1.7 : 1.4
gamma_thresh = man_gamma > 0 ? man_gamma : sensitivity == "Strict" ? 0.8 : sensitivity == "Normal" ? 0.5 : sensitivity == "Sensitive" ? 0.35 : 0.2
stress_mult = sensitivity == "Strict" ? 0.6 : sensitivity == "Normal" ? 0.55 : sensitivity == "Sensitive" ? 0.5 : 0.45

grp_risk = "═══ Risk / Invalidation ═══"
inv_stop_mult = input.float(1.0, "Invalidation Distance (ATR mult)", minval=0.25, maxval=3.0, step=0.25, group=grp_risk, tooltip="Distance from entry, in ATR multiples, at which the trade thesis is considered wrong. Plotted as a line and shown on the dashboard so every signal comes with a defined invalidation point, not just a direction.")

grp_target = "═══ Target Mode ═══"
show_structural = input.bool(true, "Show Structural Target", group=grp_target)
structural_decay = input.float(0.98, "Structural Memory", minval=0.90, maxval=0.999, step=0.005, group=grp_target)

grp_disp = "═══ Display ═══"
show_inventory = input.bool(true, "Show Inventory Z (status line)", group=grp_disp)
show_control = input.bool(true, "Show Hedge Pressure (status line)", group=grp_disp)
show_pnl = input.bool(true, "Show Dashboard", group=grp_disp)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 2: KALMAN-FILTERED INVENTORY ESTIMATION
// ═══════════════════════════════════════════════════════════════════════════════
range_val = high - low + 0.001
buy_flow = close > open ? volume * (close - open) / range_val : 0.0
sell_flow = close < open ? volume * (open - close) / range_val : 0.0
net_flow = buy_flow - sell_flow
mm_position = -net_flow

var float inventory_estimate = 0.0
var float inventory_variance = 1.0

// Real Kalman update: process noise (Q) and measurement noise (R) are
// independent parameters. Q grows the predicted variance every step (how
// much we trust the lambda-decay model); R sets how much weight new
// measurements get in the gain. Reusing a single value for both (as in
// prior versions of this script) collapses the filter into a fixed
// exponential smoother — it can no longer distinguish "the model is
// uncertain" from "this bar's flow reading is noisy."
pred_inv = inventory_estimate * (1.0 - lambda)
pred_var = inventory_variance + q_process * q_process
kalman_gain = pred_var / (pred_var + r_measurement * r_measurement)
inventory_estimate := pred_inv + kalman_gain * (mm_position - pred_inv)
inventory_variance := (1.0 - kalman_gain) * pred_var

inv_mean = ta.sma(inventory_estimate, inv_lookback)
inv_std = ta.stdev(inventory_estimate, inv_lookback)
inv_z = inv_std > 0 ? (inventory_estimate - inv_mean) / inv_std : 0.0
abs_inv_z = math.abs(inv_z)

inv_z_prev = nz(inv_z[5])
stress_building = abs_inv_z > 1.0 and abs_inv_z > math.abs(inv_z_prev)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 3: FLOW QUALITY FILTER
// ═══════════════════════════════════════════════════════════════════════════════
vol_avg = ta.sma(volume, 20)
vol_std_val = ta.stdev(volume, 20)
vol_z = vol_avg > 0 and vol_std_val > 0 ? (volume - vol_avg) / vol_std_val : 0.0
body_pct = range_val > 0 ? math.abs(close - open) / range_val : 0.0
absorption = vol_z > 1.5 and body_pct < 0.3
conviction_flow = vol_z > 1.5 and body_pct > 0.6
flow_quality = absorption ? 0.9 : conviction_flow ? 0.8 : vol_z > 0.5 ? 0.5 : 0.3

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 4: HJB OPTIMAL CONTROL (Riccati Steady-State Solution)
// ═══════════════════════════════════════════════════════════════════════════════
riccati_p = math.sqrt(c_inv * kappa_impact)
optimal_hedge_z = -(1.0 / kappa_impact) * riccati_p * inv_z
atr_val = ta.atr(14)
optimal_hedge_rate = optimal_hedge_z * atr_val

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 5: GAMMA EXPOSURE SYNTHESIS (High-Velocity 0DTE Ticker Resolution)
// NOTE: this is a round-number/volume proxy for dealer gamma, not a
// calculation from actual options chain data (strike-level OI/gamma). It's
// the standard "price gravitates to round numbers near expiry" heuristic —
// most reliable on liquid equity/index 0DTE names (SPY/QQQ/IWM-style), much
// weaker on crypto where there typically isn't the same strike-driven
// dealer-hedging dynamic. Treat "Gamma Pressure" as a proxy signal, not a
// literal read of dealer positioning.
// ═══════════════════════════════════════════════════════════════════════════════
is_crypto = syminfo.type == "crypto"
// Fixed Grid: Ensures IWM/SPY reads $1 increments properly instead of jumping by $10
strike_increment = is_crypto ? (close > 10000 ? 500.0 : close > 1000 ? 100.0 : close > 100 ? 10.0 : close > 10 ? 1.0 : close > 1 ? 0.1 : 0.01) : (close > 500 ? 5.0 : close > 100 ? 1.0 : close > 25 ? 0.5 : 0.5)

strike_below = math.floor(close / strike_increment) * strike_increment
strike_above = strike_below + strike_increment
dist_below = math.abs(close - strike_below)
dist_above = math.abs(close - strike_above)
nearest_strike = dist_below < dist_above ? strike_below : strike_above
dist_to_strike = math.min(dist_below, dist_above)

atr_pin = atr_val * 0.5
min_pin = strike_increment * 0.55
pin_range = math.max(atr_pin, min_pin)
near_strike = dist_to_strike < pin_range

vol_ratio = vol_avg > 0 ? volume / vol_avg : 1.0
gamma_intensity = near_strike ? vol_ratio : 0.0

second_strike = dist_below < dist_above ? strike_above : strike_below
dist_second = math.abs(close - second_strike)
near_second = dist_second < pin_range * 1.5
gamma_intensity_2 = near_second ? vol_ratio * 0.5 : 0.0
combined_gamma = gamma_intensity + gamma_intensity_2

atr_pct = close > 0 ? atr_val / close : 0.001
vol_regime = ta.percentrank(atr_pct, 50) / 100.0
dealer_gamma_proxy = atr_pct > 0 ? combined_gamma / (atr_pct + 0.001) : 0.0
total_gamma_pressure = dealer_gamma_proxy * abs_inv_z * (0.5 + vol_regime)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 6: CRITICAL EVENTS + SIGNALS
// ═══════════════════════════════════════════════════════════════════════════════
critical_long = inv_z > z_critical
critical_short = inv_z < -z_critical
gamma_critical = total_gamma_pressure > gamma_thresh
control_stress = abs_inv_z * (1.0 + total_gamma_pressure)
control_action = (critical_long or critical_short) and gamma_critical

crit_short_lag = critical_short[1] and gamma_critical[1]
long_signal = critical_short and gamma_critical and not crit_short_lag
crit_long_lag = critical_long[1] and gamma_critical[1]
short_signal = critical_long and gamma_critical and not crit_long_lag

raw_conf = control_stress * 20.0
signal_confidence = math.min(raw_conf * flow_quality, 99.0)
stress_warning = stress_building and not control_action and abs_inv_z > z_critical * stress_mult

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 6B: INVALIDATION TRACKING (new)
// Every signal now carries a defined invalidation level, tracked until the
// thesis either fails (price trades through it) or resolves (inventory
// z-score returns to the opposite side of zero).
// ═══════════════════════════════════════════════════════════════════════════════
var float active_invalidation = na
var int active_direction = 0   // 1 = long thesis active, -1 = short thesis active, 0 = none

if long_signal
    active_invalidation := close - atr_val * inv_stop_mult
    active_direction := 1
if short_signal
    active_invalidation := close + atr_val * inv_stop_mult
    active_direction := -1

if active_direction == 1 and (close < active_invalidation or inv_z <= 0)
    active_direction := 0
    active_invalidation := na
if active_direction == -1 and (close > active_invalidation or inv_z >= 0)
    active_direction := 0
    active_invalidation := na

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 7: DUAL-MODE PRICE TARGETS
// ═══════════════════════════════════════════════════════════════════════════════
tac_adj = optimal_hedge_z * atr_val * 0.5
tactical_target = close + tac_adj
tactical_move_pct = close > 0 ? tac_adj / close * 100 : 0.0

var float structural_imbalance = 0.0
norm_flow = vol_avg > 0 ? net_flow / vol_avg : 0.0
structural_imbalance := structural_imbalance * structural_decay + norm_flow

struct_z_mean = ta.sma(structural_imbalance, inv_lookback)
struct_z_std = ta.stdev(structural_imbalance, inv_lookback)
struct_z = struct_z_std > 0 ? (structural_imbalance - struct_z_mean) / struct_z_std : 0.0
structural_adj = -struct_z * atr_val * gamma_term
structural_target = close + structural_adj
structural_move_pct = close > 0 ? structural_adj / close * 100 : 0.0

inv_z_sq = inv_z * inv_z
hedge_z_sq = optimal_hedge_z * optimal_hedge_z
current_damage = c_inv * inv_z_sq + kappa_impact * hedge_z_sq
damage_rising = current_damage > ta.sma(current_damage, 10)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 8: VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════
colorInv = inv_z > 0 ? color.new(#FF2D55, 0) : color.new(#00FF88, 0)
plot(show_inventory ? inv_z : na, "Inventory Z", colorInv, 2, display=display.status_line)
hline(z_critical, "Critical Long", color.new(#f80000, 0), linestyle=hline.style_solid)
hline(-z_critical, "Critical Short", color.new(#1eff00, 0), linestyle=hline.style_solid)
hline(0, "Equilibrium", color.new(#ffd900, 0), linestyle=hline.style_dotted)

hedge_plot = optimal_hedge_z * 10.0
plot(show_control ? hedge_plot : na, "Hedge Rate", color.new(#00CFFF, 0), 1, display=display.status_line)

plotshape(long_signal, title="🏦", location=location.belowbar, color=color.new(#33ff00, 0), style=shape.triangleup, size=size.small, text="🏦", textcolor=color.new(#00FF88, 0))
plotshape(short_signal, title="🏦", location=location.abovebar, color=color.new(#f50000, 0), style=shape.triangledown, size=size.small, text="🏦", textcolor=color.new(#FF2D55, 0))
plotshape(stress_warning and not stress_warning[1], title="Stress Building", location=location.belowbar, color=color.new(#c8ff00, 0), style=shape.diamond, size=size.tiny)

plot(near_strike ? nearest_strike : na, "Strike Magnet", color=color.new(#f8d300, 0), style=plot.style_stepline, linewidth=2, display=display.pane)

// New: plotted invalidation level, active only while a thesis is live
plot(active_direction != 0 ? active_invalidation : na, "Invalidation Level", color=color.new(#FF0000, 20), style=plot.style_circles, linewidth=2, display=display.pane)

barcolor(long_signal ? color.new(#00ff00, 0) : short_signal ? color.new(#ff0000, 0) : control_action ? color.new(#FFFFFF, 0) : na)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 9: PLAIN ENGLISH DASHBOARD (Global Scope Optimization)
// ═══════════════════════════════════════════════════════════════════════════════
// UI Element extracted from conditional block to instantly allocate memory in v6
var table dash = table.new(position.bottom_right, 2, 17, bgcolor=color.new(#000000, 0), border_color=color.new(#FFD700, 30), border_width=1, frame_color=color.new(#FFD700, 0), frame_width=2)

if show_pnl and barstate.islast
    hdr_bg = color.new(#0A0800, 0)
    row_bg = color.new(#000000, 0)
    lbl_c  = #FFFFFF
    ts_n   = size.normal
    ts_s   = size.small

    table.cell(dash, 0, 0, "🏦SML MARKET MAKER INTEL™ v4", text_color=color.new(#ffffff, 0), text_size=ts_n, bgcolor=hdr_bg, text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 1, 0)
    table.cell(dash, 0, 1, "ScriptMasterLabs · Invite Only · " + sensitivity, text_color=color.new(#00CFFF, 0), text_size=size.tiny, bgcolor=hdr_bg, text_halign=text.align_center)
    table.merge_cells(dash, 0, 1, 1, 1)

    inv_dir = inv_z > 0.5 ? "LONG (absorbed selling)" : inv_z < -0.5 ? "SHORT (absorbed buying)" : "FLAT (balanced)"
    inv_c = inv_z > 0.5 ? color.new(#FF2D55, 0) : inv_z < -0.5 ? color.new(#00FF88, 0) : color.new(#FFD700, 0)
    table.cell(dash, 0, 2, "MM Inventory:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 2, inv_dir + "  (" + str.tostring(inv_z, "#.##") + "σ)", text_color=inv_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    meaning = inv_z > z_critical ? "MM MUST SELL → expect drop" : inv_z < -z_critical ? "MM MUST BUY → expect rally" : inv_z > 1.5 ? "MM wants to sell soon" : inv_z < -1.5 ? "MM wants to buy soon" : inv_z > 0.5 ? "Slight sell pressure building" : inv_z < -0.5 ? "Slight buy pressure building" : "No directional pressure"
    mean_c = inv_z > z_critical ? color.new(#FF2D55, 0) : inv_z < -z_critical ? color.new(#00FF88, 0) : inv_z > 1.5 ? color.new(#FF8800, 0) : inv_z < -1.5 ? color.new(#00CFFF, 0) : color.new(#FFD700, 0)
    table.cell(dash, 0, 3, "What It Means:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 3, meaning, text_color=mean_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    action = long_signal ? "🟢 BUY WITH THE MM" : short_signal ? "🔴 SELL WITH THE MM" : control_action and critical_short ? "🟢 MM buying — look for longs" : control_action and critical_long ? "🔴 MM selling — look for shorts" : stress_warning and inv_z < 0 ? "👀 Watch for buy setup" : stress_warning and inv_z > 0 ? "👀 Watch for sell setup" : "⏸ No forced action — wait"
    act_c = long_signal ? color.new(#00FF88, 0) : short_signal ? color.new(#FF2D55, 0) : control_action ? color.new(#FFFFFF, 0) : stress_warning ? color.new(#FFD700, 0) : color.new(#FFD700, 40)
    table.cell(dash, 0, 4, "Your Move:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 4, action, text_color=act_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    table.cell(dash, 0, 5, "─────────────────", text_color=color.new(#FFD700, 50), text_size=size.tiny, bgcolor=row_bg)
    table.cell(dash, 1, 5, "─────────────────", text_color=color.new(#FFD700, 50), text_size=size.tiny, bgcolor=row_bg)

    pin_txt = near_strike and gamma_critical ? "⚡ PINNING $" + str.tostring(nearest_strike, "#.##") + " (strong)" : near_strike ? "📌 Near $" + str.tostring(nearest_strike, "#.##") + " strike" : "No pin — $" + str.tostring(nearest_strike, "#.##") + " nearest"
    pin_c = near_strike and gamma_critical ? color.new(#FFFFFF, 0) : near_strike ? color.new(#FFD700, 0) : color.new(#FFD700, 40)
    table.cell(dash, 0, 6, "Strike Pin:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 6, pin_txt, text_color=pin_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    gp_txt = gamma_critical ? "🔥 HIGH — MM forced to hedge" : total_gamma_pressure > gamma_thresh * 0.5 ? "⚠ ELEVATED — hedge likely" : "LOW — no gamma pressure"
    gp_c = gamma_critical ? color.new(#FFFFFF, 0) : total_gamma_pressure > gamma_thresh * 0.5 ? color.new(#FFD700, 0) : color.new(#FFD700, 40)
    table.cell(dash, 0, 7, "Gamma Pressure*:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 7, gp_txt + "  (" + str.tostring(total_gamma_pressure, "#.##") + ")", text_color=gp_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    fq_txt = absorption ? "🏦 INSTITUTIONAL (quiet accumulation)" : conviction_flow ? "🏦 INSTITUTIONAL (directional push)" : flow_quality > 0.4 ? "Mixed (some smart money)" : "Noise (no institutional signal)"
    fq_c = flow_quality > 0.7 ? color.new(#00FF88, 0) : flow_quality > 0.4 ? color.new(#FFD700, 0) : color.new(#FFD700, 40)
    table.cell(dash, 0, 8, "Flow Quality:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 8, fq_txt, text_color=fq_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    table.cell(dash, 0, 9, "─────────────────", text_color=color.new(#FFD700, 50), text_size=size.tiny, bgcolor=row_bg)
    table.cell(dash, 1, 9, "─────────────────", text_color=color.new(#FFD700, 50), text_size=size.tiny, bgcolor=row_bg)

    tac_dir = tactical_move_pct > 0 ? "▲" : tactical_move_pct < 0 ? "▼" : "—"
    tac_c = tactical_move_pct > 0 ? color.new(#00FF88, 0) : tactical_move_pct < 0 ? color.new(#FF2D55, 0) : color.new(#FFD700, 0)
    table.cell(dash, 0, 10, "Short-Term Target:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 10, tac_dir + " $" + str.tostring(tactical_target, "#.##") + "  (" + str.tostring(tactical_move_pct, "#.##") + "%)", text_color=tac_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    conf_txt = signal_confidence > 80 ? "🟢 HIGH" : signal_confidence > 50 ? "🟡 MODERATE" : signal_confidence > 20 ? "🟠 LOW" : "⚪ MINIMAL"
    conf_c = signal_confidence > 80 ? color.new(#00FF88, 0) : signal_confidence > 50 ? color.new(#FFD700, 0) : color.new(#FFD700, 40)
    table.cell(dash, 0, 11, "Confidence:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 11, conf_txt + "  (" + str.tostring(signal_confidence, "#") + "%)", text_color=conf_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    inval_txt = active_direction != 0 ? "$" + str.tostring(active_invalidation, "#.##") + (active_direction == 1 ? " (below)" : " (above)") : "No active thesis"
    inval_c = active_direction != 0 ? color.new(#FF0000, 0) : color.new(#FFD700, 40)
    table.cell(dash, 0, 12, "Invalidation:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 12, inval_txt, text_color=inval_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    dmg_txt = damage_rising ? "▲ RISING — MM losing money" : "▼ FALLING — MM stabilizing"
    dmg_c = damage_rising ? color.new(#FF2D55, 0) : color.new(#00FF88, 0)
    table.cell(dash, 0, 13, "MM Pain Level:", text_color=color.new(lbl_c, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
    table.cell(dash, 1, 13, dmg_txt, text_color=dmg_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

    if show_structural
        table.cell(dash, 0, 14, "─────────────────", text_color=color.new(#FFD700, 50), text_size=size.tiny, bgcolor=row_bg)
        table.cell(dash, 1, 14, "─────────────────", text_color=color.new(#FFD700, 50), text_size=size.tiny, bgcolor=row_bg)

        str_dir = structural_move_pct > 0 ? "▲" : structural_move_pct < 0 ? "▼" : "—"
        str_c = structural_move_pct > 5 ? color.new(#00FF88, 0) : structural_move_pct < -5 ? color.new(#FF2D55, 0) : color.new(#FFD700, 0)
        table.cell(dash, 0, 15, "Macro Target:", text_color=color.new(#FFD700, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
        table.cell(dash, 1, 15, str_dir + " $" + str.tostring(structural_target, "#.##") + "  (" + str.tostring(structural_move_pct, "#.##") + "%)", text_color=str_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

        imb_txt = structural_imbalance > 0 ? "NET BUYING ▲ (MM short → bullish)" : structural_imbalance < 0 ? "NET SELLING ▼ (MM long → bearish)" : "NEUTRAL"
        imb_c = structural_imbalance > 0 ? color.new(#00FF88, 0) : structural_imbalance < 0 ? color.new(#FF2D55, 0) : color.new(#FFD700, 0)
        table.cell(dash, 0, 16, "Macro Flow:", text_color=color.new(#FFD700, 0), text_size=ts_s, bgcolor=row_bg, text_halign=text.align_left)
        table.cell(dash, 1, 16, imb_txt, text_color=imb_c, text_size=ts_n, bgcolor=row_bg, text_halign=text.align_right)

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 10: ALERTS — DUAL SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════
if long_signal
    alert("SML MM Intel — " + syminfo.ticker + " — MM FORCED BUY at " + str.tostring(close) + " | Inv Z: " + str.tostring(inv_z, "#.##") + " | Conf: " + str.tostring(signal_confidence, "#") + "% | Invalidation: " + str.tostring(active_invalidation, "#.##"), alert.freq_once_per_bar_close)
if short_signal
    alert("SML MM Intel — " + syminfo.ticker + " — MM FORCED SELL at " + str.tostring(close) + " | Inv Z: " + str.tostring(inv_z, "#.##") + " | Conf: " + str.tostring(signal_confidence, "#") + "% | Invalidation: " + str.tostring(active_invalidation, "#.##"), alert.freq_once_per_bar_close)
if stress_warning and not stress_warning[1]
    alert("SML MM Intel — " + syminfo.ticker + " — STRESS BUILDING | Inv Z: " + str.tostring(inv_z, "#.##") + " | Watch for forced action", alert.freq_once_per_bar_close)

alertcondition(long_signal, "MM Forced Buy", "MM forced to buy — expect rally")
alertcondition(short_signal, "MM Forced Sell", "MM forced to sell — expect drop")
alertcondition(control_action, "Control Action", "MM inventory critical + gamma pressure — forced hedge")
alertcondition(stress_warning and not stress_warning[1], "Stress Building", "Inventory stress building — watch for forced action")
alertcondition(absorption, "Institutional Absorption", "High volume + small body — smart money accumulating")
