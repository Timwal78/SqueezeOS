# SqueezeOS GOD MODE / RH Executor — desk defaults (2026-07-29)
# Copy to executor.env OR let START_EXECUTOR.bat merge these keys automatically.
# Secrets (ROBINHOOD_*, MACRO_GATE_SECRET, DISCORD_*) stay only in local executor.env

POLL_INTERVAL_S=45
SQUEEZEOS_API_URL=https://squeezeos-api.onrender.com

# GOD_MODE gate
MIN_GOD_STACKED=3
ORACLE_MIN_CONFIDENCE=60.0
COOLDOWN_S=900

# Risk rails
MAX_ORDER_USD=150.0
MAX_EQUITY_SHARES=25
# Both 0 below = uncapped (operator directive 2026-07-29, semi-day-trading
# throughput) -- MAX_DAILY_LOSS_USD stays the real circuit breaker.
MAX_ORDERS_PER_DAY=0
MAX_DAILY_NOTIONAL_USD=0
MAX_DAILY_LOSS_USD=100.0
MAX_PER_SCAN=3
PDT_BALANCE_LIMIT=2000.0
PDT_MAX_TRADES=3
# Set PDT_MAX_TRADES=0 to remove this voluntary shield entirely (uncapped day trades below PDT_BALANCE_LIMIT) -- operator directive 2026-07-30
STOP_LOSS_PCT=5.0
TAKE_PROFIT_PCT=15.0
POSITION_MONITOR_ENABLED=true
MAX_SPREAD_PCT=2.0
FILL_ALERT_MINUTES=10.0

# Paper / kill
ROBINHOOD_PAPER_MODE=false
KILL_SWITCH=false

# Options sleeve — MM forced-move continuous harvest (50–500%)
EXEC_BROKER=robinhood
ROBINHOOD_OPTION_QTY=1
OPTIONS_DELTA_MIN=0.30
OPTIONS_DELTA_MAX=0.40
OPTIONS_DELTA_TARGET=0.35
OPT_HARD_STOP=-0.20
OPT_SCALE_1=0.50
OPT_SCALE_2=1.50
OPT_BANK_300=3.00
OPT_BANK_500=5.00
OPT_GIVEBACK_ARM=0.50
OPT_GIVEBACK_FRAC=0.35
OPT_TRAIL=0.22
OPT_TRAIL_LATE=0.18
OPT_DELTA_EXIT=0.60
# Default false 2026-07-29: real backtest (docs/GAMMA_RAMP_BACKTEST_2026-07-29.md)
# came back PF 0.74, losing on 4/5 symbols. Set true only after a fresh,
# evidence-backed decision to re-enable this desk -- do not flip casually.
GAMMA_RAMP_POLL_ENABLED=false
GAMMA_RAMP_OUTBOX_DIR=tools/gamma_ramp/rh_outbox

# Optional secrets — fill locally, never commit:
# ROBINHOOD_USERNAME=
# ROBINHOOD_PASSWORD=
# MACRO_GATE_SECRET=
# DISCORD_WEBHOOK_BEAST=
# DISCORD_WEBHOOK_ALL=
